{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with referral details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "referralCode": { "type": "string", "description": "Code this user shares with others" },
        "referredBy": { "type": "string", "description": "Code used by this user to join" },
        "referralCount": { "type": "integer", "description": "Number of successful referrals" },
        "referralRewards": { "type": "integer", "description": "Total discount earned" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Enquiry": {
      "title": "Contact Enquiry",
      "description": "Public contact enquiry",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "subject", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Collection for public enquiries"
    }
  }
}
